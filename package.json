{
  "name": "finance-bot",
  "version": "0.1.0",
  "description": "Finance bot: bot keuangan Telegram (PostgreSQL, Ollama, OCR)",
  "author": "Walid Hanif Ataullah",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "acceptance:check": "bash scripts/acceptance-check.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:soak": "node --expose-gc node_modules/jest/bin/jest.js --config ./test/jest-soak.json --runInBand",
    "test:failure": "jest --config ./test/jest-failure.json --runInBand",
    "test:queue": "docker compose --profile queue up -d --wait redis && jest --config ./test/jest-queue.json --runInBand",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "db:verify": "bash scripts/verify-integrity.sh",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore-rehearsal": "bash scripts/restore-rehearsal.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "test:mutation": "node scripts/mutation-checks.js",
    "docker:verify": "node scripts/verify-docker-limits.js",
    "db:migrate-rehearsal": "bash scripts/migration-rehearsal.sh",
    "disk:check": "node scripts/disk-check.js",
    "queue:status": "node scripts/queue-status.js",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:integration && npm run test:e2e && npm run test:queue && npm run build && npm audit --omit=dev --audit-level=critical",
    "receipt:fetch-langdata": "node scripts/fetch-tessdata.mjs",
    "receipt:eval": "npm run build && node dist/modules/receipt/evaluation/evaluate.js",
    "receipt:live-check": "npm run build && node dist/modules/receipt/live-check.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^6.3.15",
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.3.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.6.1",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/evaluation/**",
      "!**/live-check.ts",
      "!**/cli.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "sharp@0.35.5": true,
    "@scarf/scarf": false,
    "tesseract.js": false
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.4.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
