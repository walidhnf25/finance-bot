{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/failure/.*[.]failure-spec[.]ts$",
  "transform": { "^.+[.](t|j)s$": "ts-jest" },
  "moduleNameMapper": { "^src/(.*)$": "<rootDir>/src/$1" },
  "setupFiles": ["<rootDir>/test/setup/env.ts"],
  "testTimeout": 180000,
  "maxWorkers": 1
}
