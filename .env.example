# ============================================================
# Finance bot — configuration (EXAMPLE)
#
# Copy to `.env` and fill in. Real values stay on your machine: `.env*` files are git-ignored.
# One `.env` file is enough. `.env.<NODE_ENV>` is still read first if you ever create one.
# Startup validates every value and refuses to boot on an unsafe or invalid configuration.
# ============================================================

# --- PostgreSQL (docker compose) ---------------------------------------------------------------
# Used by docker-compose.yml. Pick a long random password; it only ever listens on 127.0.0.1.
POSTGRES_USER=finance_bot
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=finance_bot
# 15432 on purpose: 5432 is usually taken by other Postgres containers.
POSTGRES_PORT=15432
# Must match the values above (the app and Prisma read this one).
DATABASE_URL=postgresql://finance_bot:change-me-to-a-long-random-value@127.0.0.1:15432/finance_bot?schema=public
# Tests use their own database and refuse to run against any other (see src/testing/db-guard.ts).
# TEST_DATABASE_URL=postgresql://finance_bot:...@127.0.0.1:15432/finance_bot_test?schema=public

# --- App ---------------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# The HTTP API has no login, so it listens on loopback only. A non-loopback HOST needs
# ALLOW_REMOTE_BIND=true AND something in front of it that you control.
HOST=127.0.0.1
# ALLOW_REMOTE_BIND=false
APP_NAME=finance-bot
TZ=Asia/Jakarta
LOG_LEVEL=info
LOG_PRETTY=true

# --- Telegram ----------------------------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# true  = the app fetches updates itself (long polling). Simplest option, no public URL.
# false = webhook mode: TELEGRAM_WEBHOOK_SECRET is mandatory and every request is verified.
TELEGRAM_POLLING=true
# Webhook mode only: 16-256 characters of A-Z a-z 0-9 _ -  (use the same value as setWebhook's secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Who may use the bot. Set the numeric Telegram user ids (comma separated)...
TELEGRAM_ALLOWED_USER_IDS=
# ...or deliberately open it to everyone (an EMPTY allowlist alone means NO ONE, not everyone).
# TELEGRAM_ALLOW_PUBLIC=true
USER_RATE_LIMIT_PER_MINUTE=30
# Longest chat message accepted (characters, 100-4096). Longer text is refused with a short reply and never parsed.
MAX_INPUT_CHARS=2000

# --- AI (Ollama) -------------------------------------------------------------------------
# ollama = use an Ollama server for receipt photos; none = no AI (the bot still works).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave empty to use the first installed model that supports completion, or name one you have pulled
# (`ollama list`). Nothing is downloaded automatically. A model can read the picture itself only if
# Ollama reports it as "vision" capable; otherwise OCR text is structured by the model instead.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=120000
OLLAMA_MAX_RESPONSE_BYTES=1048576
# Circuit breaker: after this many consecutive failures the model is paused for the cooldown, so a dead
# Ollama costs one fast failure instead of a full timeout per receipt. One probe request then tests recovery.
OLLAMA_BREAKER_FAILURES=3
OLLAMA_BREAKER_COOLDOWN_SECONDS=30

# --- Receipt photos ----------------------------------------------------------------------------
RECEIPT_MAX_FILE_SIZE_BYTES=5242880
RECEIPT_MAX_PIXELS=25000000
# How long a read receipt waits for your "ya" before it expires.
RECEIPT_PENDING_TTL_MINUTES=30
RECEIPT_MAX_PER_HOUR=20
# auto   = the printed total line is read by code; the model is only asked when that is unsure (fast)
# always = the model reads every receipt (15-35 s each on CPU; the printed total line still wins)
# never  = never use the model
RECEIPT_AI_MODE=auto

# --- Retention (housekeeping of data that is NOT your finances) ----------------------------------
# Never touches users, transactions, transfers, budgets, categories or confirmed receipts.
# How often the cleanup runs (hours, 1-168); the first run is one minute after start.
RETENTION_INTERVAL_HOURS=6
# Cancelled/expired receipt drafts are deleted after this many days (0 = keep forever, max 3650).
RECEIPT_DRAFT_RETENTION_DAYS=30
# Rows of the audit trail (audit_events) older than this many days are deleted (0 = keep forever, max 3650).
AUDIT_RETENTION_DAYS=365

# --- Optional background queue (Redis + BullMQ) ---------------------------------------------------
# Leave REDIS_URL empty (the default) and nothing changes: receipt photos are read right inside the chat
# handler. With Redis, photos are read by a background worker: retried with backoff, they survive a restart,
# and the chat answers at once ("Struk diterima"). Redis holds only job references (ids, a Telegram file id),
# never a photo, text or amount. If Redis is unreachable the bot falls back to reading in-process.
#   docker compose --profile queue up -d --wait redis        then set:
# REDIS_URL=redis://127.0.0.1:16379
# REDIS_PASSWORD=                  (optional; compose + REDIS_URL must carry the same password)
# REDIS_KEY_PREFIX=finance-bot:
# REDIS_CONNECT_TIMEOUT_MS=2000
# A non-loopback Redis without a password is refused unless REDIS_ALLOW_UNAUTHENTICATED=true.
# Receipt reading is CPU/Ollama-bound and OCR itself is serial: keep concurrency at 1 unless you measured better.
RECEIPT_WORKER_CONCURRENCY=1
RECEIPT_JOB_ATTEMPTS=3
RECEIPT_JOB_BACKOFF_SECONDS=5
RECEIPT_JOB_TIMEOUT_SECONDS=300

# --- Swagger (off by default) --------------------------------------------------
SWAGGER_ENABLED=false
SWAGGER_PATH=docs
